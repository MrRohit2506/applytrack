# Base URL of the API as seen by the BROWSER.
# Default "/api" works with the Vite dev proxy (same-origin, no CORS needed in development).
# For a separately hosted API use its full URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Dev proxy target (used only by `npm run dev`): where the Express server listens.
VITE_DEV_API_TARGET=http://localhost:5000
