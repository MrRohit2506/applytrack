# Copy to server/.env and fill in. Never commit server/.env.

# development | test | production
NODE_ENV=development
PORT=5000

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/applytrack
# Atlas: mongodb+srv://<user>:<password>@<cluster>/applytrack?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/applytrack

# Secrets: each must be >= 32 chars and different from each other.
# Generate with: openssl rand -hex 32   (values starting with CHANGE_ME are rejected)
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
CSRF_SECRET=CHANGE_ME_generate_a_different_one_too_32+

# Session lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168

# Comma-separated explicit browser origins allowed for CORS + CSRF origin check.
# Dev (Vite): http://localhost:5173   -- no wildcard allowed.
CLIENT_ORIGIN=http://localhost:5173

# Cookie policy. lax = same-site frontend/API (incl. Vite proxy in dev).
# Use "none" ONLY for cross-site deployments (requires HTTPS / secure cookies).
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production, false otherwise. Must be true in production.
# COOKIE_SECURE=true
# Optional cookie domain, e.g. .example.com (leave unset for host-only cookies)
# COOKIE_DOMAIN=

# bcrypt cost factor (4-15). 12 is a sensible default.
BCRYPT_ROUNDS=12

# Number of reverse proxies in front of the app (0 = none). Needed for correct client IPs
# for rate limiting and secure cookies behind a proxy/load balancer.
TRUST_PROXY=0

# In-app deadline reminders: default look-ahead window in days (1-90)
REMINDER_WINDOW_DAYS=7

# CSV import limits: max request size in bytes (default 1 MiB, max 10 MiB) and max data rows
IMPORT_MAX_BYTES=1048576
IMPORT_MAX_ROWS=1000

# Whole-API rate limit per IP per 15 minutes (filtering/paging makes many small requests)
API_RATE_LIMIT_MAX=1000

# Failed logins allowed per ACCOUNT (email) per window, in addition to the per-IP limit below
LOGIN_FAILURE_LIMIT=10

# Rate limiting for /api/auth/login and /api/auth/register (per IP)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Optional, tests only: use your own ISOLATED database (name must contain "test").
# If unset, tests start an in-memory MongoDB (mongodb-memory-server).
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/applytrack_test
